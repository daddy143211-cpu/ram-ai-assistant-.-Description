
import streamlit as st
from openai import OpenAI

st.set_page_config(
    page_title="Ram AI Education Assistant",
    page_icon="📚",
    layout="centered"
)

st.title("🙏 Ram AI Education Assistant")
st.write("Your personal AI teacher for every subject.")
st.caption("Learn in English or Telugu | Ask questions | Practice and revise")

with st.sidebar:
    st.header("Study Settings")
    language = st.selectbox(
        "Choose your language",
        ["English", "తెలుగు (Telugu)", "Both English and Telugu"]
    )
    subject = st.selectbox(
        "Choose your subject",
        [
            "All Subjects",
            "Mathematics",
            "Science",
            "English",
            "Social Studies",
            "Computer Science",
            "Python Programming",
            "Java Programming",
            "SQL and Databases",
            "Artificial Intelligence",
            "General Knowledge",
            "Other"
        ]
    )
    mode = st.selectbox(
        "Choose study mode",
        [
            "Learn a Topic",
            "Make Study Notes",
            "Practice Quiz",
            "Explain Step by Step",
            "Exam Preparation",
            "Homework Help"
        ]
    )
    if st.button("Clear Chat"):
        st.session_state.messages = []
        st.rerun()

if "messages" not in st.session_state:
    st.session_state.messages = []

for message in st.session_state.messages:
    with st.chat_message(message["role"]):
        st.markdown(message["content"])

question = st.chat_input(
    "Ask Ram AI anything you want to learn..."
)

if question:
    st.session_state.messages.append(
        {"role": "user", "content": question}
    )

    with st.chat_message("user"):
        st.markdown(question)

    instructions = f"""
You are Ram AI Education Assistant, a friendly personal tutor.

Selected language: {language}
Selected subject: {subject}
Study mode: {mode}

Help learners with all school, college, university,
programming, science, mathematics, language, and general
knowledge subjects.

Use the selected language consistently. If Telugu is selected,
answer in natural Telugu. If both languages are selected,
explain in both English and Telugu.

Explain difficult concepts in simple steps.
Use examples, definitions, and practice questions when useful.
For quizzes, ask questions and let the learner try before
revealing answers when appropriate.
For mathematics, show the calculation steps.
For programming, provide working code and explain how to use it.
For exam preparation, provide revision notes and practice tests.
If a question is unclear, ask a short clarifying question.
Be accurate and admit uncertainty rather than inventing facts.
Never claim an answer is guaranteed to be correct.
"""

    try:
        client = OpenAI(
            api_key=st.secrets["OPENAI_API_KEY"]
        )

        with st.chat_message("assistant"):
            with st.spinner("Ram AI is preparing your answer..."):
                response = client.responses.create(
                    model="gpt-4.1-mini",
                    instructions=instructions,
                    input=st.session_state.messages
                )
                answer = response.output_text
                st.markdown(answer)

        st.session_state.messages.append(
            {"role": "assistant", "content": answer}
        )

    except KeyError:
        st.error(
            "AI setup is not complete yet. Please configure "
            "OPENAI_API_KEY in your app's Secrets settings."
        )
    except Exception:
        st.error(
            "Something went wrong while getting your answer. "
            "Please check your API key, account access, and "
            "internet connection, then try again."
        )
